{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "chore-champ": "link:",
    "cypress": "^15.11.0",
    "eslint": "8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "turbo": "^2.8.16",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "name": "chore-champ",
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build --cache-dir=.turbo",
    "clean": "rimraf node_modules **/node_modules **/dist",
    "dev": "turbo run dev --parallel",
    "format": "prettier -w .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky",
    "test": "jest -c ./jest.config.cjs --passWithNoTests",
    "test:watch": "jest -c ./jest.config.cjs --watch",
    "typecheck": "turbo run typecheck",
    "husky:pre-commit": "sh .husky/pre-commit"
  },
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
