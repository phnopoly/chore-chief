{
  "devDependencies": {
    "eslint": "8.57.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.8.16",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "name": "chore-champ",
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build --cache-dir=.turbo",
    "clean": "rimraf node_modules **/node_modules **/dist",
    "dev": "turbo run dev --parallel",
    "format": "prettier -w .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky",
    "test": "jest -c ./jest.config.cjs --passWithNoTests",
    "test:watch": "jest -c ./jest.config.cjs --watch",
    "typecheck": "turbo run typecheck"
  },
  "version": "1.0.0"
}
