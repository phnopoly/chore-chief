{
  "name": "chore-champ",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --continue",
    "build": "turbo run build",
    "build:ci": "turbo run build --cache-dir=.turbo",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "jest -c ./jest.config.cjs --passWithNoTests",
    "test:watch": "jest -c ./jest.config.cjs --watch",
    "format": "prettier -w .",
    "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .turbo",
    "ci:local": "pnpm install --frozen-lockfile && pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "chore-champ": "link:",
    "cypress": "^15.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@chakra-ui/react": "2.8.2",
      "eslint": "8.57.1",
      "next": "14.2.5",
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  }
}
