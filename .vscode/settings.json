{
  "cSpell.ignorePaths": ["pnpm-lock.yaml"],
  "cSpell.words": [
    "backsplash",
    "chakra",
    "changeme",
    "chorechamp",
    "Cleanout",
    "codegen",
    "cuttingboards",
    "dishrack",
    "eslintcache",
    "gamify",
    "HVAC",
    "Manideep",
    "miragejs",
    "NEXTAUTH",
    "nodenext",
    "Phong",
    "putaway",
    "qstash",
    "stovetop",
    "tsparser",
    "Turborepo",
    "USERPROFILE",
    "vercel"
  ],
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/dist/**": true
  },
  "typescript.tsdk": "node_modules/typescript/lib"
}
