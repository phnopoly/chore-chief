{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "resolveJsonModule": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "extends": "../../tsconfig.base.json",
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "jest.setup.web.ts",
    "next-env.d.ts",
    "src",
    "src/**/*.(test|spec).ts",
    "src/**/*.(test|spec).tsx"
  ]
}
