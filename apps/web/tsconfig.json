{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src",
    "jest.setup.web.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "src/**/*.(test|spec).ts",
    "src/**/*.(test|spec).tsx"
  ],
  "exclude": ["node_modules"]
}
