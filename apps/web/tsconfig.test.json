{
  "compilerOptions": {
    "isolatedModules": false,
    "noEmit": true,
    "rootDir": ".",
    "types": ["@testing-library/jest-dom", "jest", "node"]
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "jest.setup.web.ts",
    "next-env.d.ts",
    "src",
    "src/**/*.(test|spec).ts",
    "src/**/*.(test|spec).tsx"
  ]
}
