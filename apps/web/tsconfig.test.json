{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": false,
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "moduleResolution": "Node"
  },
  "include": [
    "next-env.d.ts",
    "src",
    "jest.setup.web.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "src/**/*.(test|spec).ts",
    "src/**/*.(test|spec).tsx"
  ]
}
