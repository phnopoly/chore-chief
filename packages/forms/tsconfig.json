{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "extends": "../../tsconfig.base.json",
  "include": ["src"]
}
