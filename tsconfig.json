{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["apps", "jest.setup.*.ts", "packages", "tests"],
  "references": [
    { "path": "apps/web" },
    { "path": "apps/api" },
    { "path": "packages/api-client" },
    { "path": "packages/config" },
    { "path": "packages/forms" },
    { "path": "packages/mirage" },
    { "path": "packages/types" },
    { "path": "packages/ui" },
    { "path": "packages/utils" }
  ]
}
